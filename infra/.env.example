# Shared Postgres (also used by apps/api via localhost:5432)
POSTGRES_USER=portfolio
POSTGRES_DB=portfolio
# URL-safe secret — generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Umami session/signing secret (min ~32 chars) — generate: openssl rand -hex 32
APP_SECRET=

# --- Phase 4: host port bindings (all bound to 127.0.0.1) ---
WEB_PORT=8080
API_PORT=3000
UMAMI_PORT=3001
POSTGRES_PORT=5432

# --- Phase 4: API runtime ---
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGIN=http://localhost:8080
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=20

# --- Phase 4: web build args (PUBLIC — inlined into the JS bundle) ---
# Never put a secret here. Changing any of these requires rebuilding the web image.
VITE_API_URL=http://localhost:3000
VITE_UMAMI_URL=http://localhost:3001
VITE_UMAMI_WEBSITE_ID=

# --- Phase 5: production deployment (Pi) ---
# Compose reads this file for CLI settings too. Production profiles are set
# below so a plain `docker compose up -d` publishes and monitors the site.
# Leave it unset on a dev machine, where there are no tunnel credentials.

# Production values — the VITE_* ones are baked into the web image at build time.
# CORS_ORIGIN=https://joelitoo.com
# VITE_API_URL=https://api.joelitoo.com
# VITE_UMAMI_URL=https://analytics.joelitoo.com
# VITE_UMAMI_WEBSITE_ID=

# --- Phase 6: immutable deployment and monitoring ---
# Leave image overrides unset for local :local builds. The deploy workflow sets
# these to the full release SHA for each production deployment.
# API_IMAGE=ghcr.io/joelitooo/portfolio-api:<full-git-sha>
# WEB_IMAGE=ghcr.io/joelitooo/portfolio-web:<full-git-sha>

# Enable both production-only services on the Pi. Kuma remains loopback-only.
COMPOSE_PROFILES=tunnel,monitoring
KUMA_PORT=3002
